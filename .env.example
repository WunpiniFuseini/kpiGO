# Copy to .env and adjust. Every setting kpiGo reads is listed here.
KPIGO_SECRET_KEY=change-me-before-install
KPIGO_ALLOWED_HOSTS=localhost,127.0.0.1
KPIGO_DEBUG=false
KPIGO_SECURE_COOKIES=true
POSTGRES_DB=kpigo
POSTGRES_USER=kpigo
POSTGRES_PASSWORD=change-me
# --- First run ---------------------------------------------------------------
# One-time token for setup.bootstrap, which creates the first Admin. Remove it
# once the Admin exists. Or KPIGO_SETUP_TOKEN_FILE on the secret mount.
KPIGO_SETUP_TOKEN=
# --- Licence -----------------------------------------------------------------
# Modules come from the signed licence (Administer -> Health -> Licence). This
# list applies only to development installs (KPIGO_DEBUG=true).
KPIGO_ENTITLED_MODULES=scorecards,agent_performance,campaign,executive
# The licence heartbeat: the only outbound call. Leave empty when air-gapped.
KPIGO_LICENCE_HEARTBEAT_URL=
KPIGO_LICENCE_HEARTBEAT_USER=
# Maker-checker classes forced on for the whole install (Admins can turn on
# others): metric_change,hierarchy_change,calendar_change,period_close,config_change,access_change
KPIGO_APPROVAL_CLASSES_ENABLED=
# --- Sessions and sign-in ----------------------------------------------------
KPIGO_SESSION_IDLE_MINUTES=30
KPIGO_SESSION_MAX_HOURS=12
# local | ldap | oidc | saml: the sign-in method new users get by default
KPIGO_DEFAULT_AUTH_PROVIDER=local
KPIGO_LOCAL_LOGIN=true
KPIGO_LOGIN_MAX_ATTEMPTS=5
KPIGO_LOGIN_LOCKOUT_MINUTES=15
# OIDC (Entra ID, Okta, Keycloak). Redirect URI: https://<host>/auth/callback
KPIGO_OIDC_ISSUER=
KPIGO_OIDC_CLIENT_ID=
KPIGO_OIDC_CLIENT_SECRET=
KPIGO_OIDC_REDIRECT_URI=
KPIGO_OIDC_EMAIL_CLAIM=email
KPIGO_OIDC_REQUIRE_MFA=false
# SAML 2.0. ACS URL: https://<host>/api/v1/auth/saml/acs
KPIGO_SAML_IDP_ENTITY_ID=
KPIGO_SAML_IDP_SSO_URL=
KPIGO_SAML_IDP_CERT_FILE=
KPIGO_SAML_SP_ENTITY_ID=
KPIGO_SAML_ACS_URL=
KPIGO_SAML_EMAIL_ATTRIBUTE=
KPIGO_SAML_REQUIRED_AUTHN_CONTEXT=
# On-prem LDAP / AD: password sign-in by bind, and roster import.
KPIGO_LDAP_URL=
KPIGO_LDAP_BIND_DN=
KPIGO_LDAP_BIND_PASSWORD=
KPIGO_LDAP_USER_BASE=
KPIGO_LDAP_USER_FILTER=(&(objectClass=person)(mail={email}))
KPIGO_LDAP_ATTR_STAFF_NO=employeeID
# Entra ID roster import through Microsoft Graph (User.Read.All application permission).
KPIGO_ENTRA_TENANT_ID=
KPIGO_ENTRA_CLIENT_ID=
KPIGO_ENTRA_CLIENT_SECRET=
KPIGO_ENTRA_STAFF_NO_ATTRIBUTE=employeeId
KPIGO_MAINTENANCE_MODE=false
# Optional: run platform.hello on a schedule as this user (proves the job path)
KPIGO_HELLO_SCHEDULE_USER=
# Fernet keys for source-database passwords, comma-separated; the first encrypts.
# Generate one: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Or put them in a file on the host's secret mount and set KPIGO_CREDENTIAL_KEY_FILE.
KPIGO_CREDENTIAL_KEYS=
KPIGO_CREDENTIAL_KEY_FILE=
# Ingestion limits: every read stops at the row cap; pulls run under the timeout.
KPIGO_INGEST_ROW_CAP=1000000
KPIGO_PULL_TIMEOUT_SECONDS=300
# Run feed.tick (drop folders, cadences, freshness) every minute as this user.
KPIGO_INGESTION_SCHEDULE_USER=
# Run the manual-input escalation ladder (checked daily) as this user (needs input.manage).
KPIGO_INPUT_REMINDER_USER=
# Agent Performance: months of daily detail kept hot (default 24); older months roll
# up to monthly and move to the archive schema, never deleted. Run it daily as this
# user (needs agent.retention.manage); optionally into this tablespace.
KPIGO_DAILY_HOT_MONTHS=24
KPIGO_RETENTION_USER=
KPIGO_ARCHIVE_TABLESPACE=
# Inference stays unset. kpiGo must run fully without a model.
KPIGO_INFERENCE_PROVIDER=

# Email (optional). Unset, kpiGo sends no email and reminders stay in-app.
# Mail goes only to this relay, never anywhere else.
KPIGO_EMAIL_HOST=
KPIGO_EMAIL_PORT=
# starttls (default, port 587), tls (port 465) or none
KPIGO_EMAIL_SECURITY=starttls
KPIGO_EMAIL_USER=
# Or KPIGO_EMAIL_PASSWORD_FILE on the secret mount.
KPIGO_EMAIL_PASSWORD=
KPIGO_EMAIL_FROM=
# Where people open kpiGo, so emails can link to it, e.g. https://kpigo.bank.example
KPIGO_PUBLIC_URL=
